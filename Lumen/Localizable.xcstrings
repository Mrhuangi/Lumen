    "加载本地字幕（SRT / ASS / SSA / VTT），字幕字号可调": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load local subtitle files (SRT / ASS / SSA / VTT), with adjustable subtitle size."
