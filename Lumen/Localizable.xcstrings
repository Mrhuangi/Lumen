      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct playback is the default and starts instantly. In Native Mode, videos are losslessly remuxed before playing in the system player, which starts more slowly. Switching modes reloads the current video."
          }
        },
